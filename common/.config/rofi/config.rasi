* {
    bg-col:  #1e1e2e;
    bg-col-light: #1e1e2e;
    selected-col: #1e1e2e;
    border-col: #a6e3a1;
    fg-col: #cdd6f4;
    fg-col2: #f38ba8;

    blue: #89b4fa;
    grey: #6c7086;
    pink: #f5c2e7;
    green: #a6e3a1;
    red: #f38ba8;


    width: 600;
    font: "Hermit Bold 12";
}

@theme "~/.config/rofi/nord.rasi"

configuration {
    modes: [ drun ];
    combi-modes: [ window, drun ];
    dpi: 125;
}


